A=[7 -1 0 0; -1 2 -1 0; 0 -1 2 -1; 0 0 -1 1];
n=9;A=rand(n,n);A=A*A';%+eye(n,n);
b=[1.3; .8; 1; 2];
b=rand(n,1);
unc = 0.1;
n=length(A);

pen = qps(A,b);   % nominal QP
p0 = penlab(pen); %p0.opts.outlev=0;
solve(p0); x0 = p0.x;

pen=qps(A+unc*eye(n,n),b);   % robust counterpart
p1 = penlab(pen); %p1.opts.outlev=0;
solve(p1); x1=p1.x;

pen=rob_sdpsub(A,b,unc,x1); % find feasible A
p2 = penlab(pen); %p2.opts.outlev=0;
solve(p2); U = -p2.Y{1};

pen = qps(A+unc.*U,b); %robust feasible counterpart
p3 = penlab(pen); %p3.opts.outlev=0;
solve(p3); x2 = p3.x;

pen=rob_sdpsub(A,b,unc,x2); % find feasible A
p4 = penlab(pen); %p2.opts.outlev=0;
solve(p4); U2 = -p4.Y{1};

pen = qps(A+unc.*U2,b); %robust feasible counterpart
p5 = penlab(pen); %p3.opts.outlev=0;
solve(p5); x5 = p5.x;

% pen=rob_sdpsub(A,b,unc,x5); % find feasible A
% p6 = penlab(pen); %p2.opts.outlev=0;
% solve(p6); U6 = -p6.Y{1};
% 
% pen = qps(A+unc.*U6,b); %robust feasible counterpart
% p7 = penlab(pen); %p3.opts.outlev=0;
% solve(p7); x7 = p7.x;

q0=x0'*A*x0-b'*x0+2;
q1=x1'*(A+unc*eye(n,n))*x1-b'*x1+2;
q2=x2'*(A+unc*U)*x2-b'*x2+2;
q3=x5'*(A+unc*U2)*x5-b'*x5+2;
q4=x7'*(A+unc*U6)*x7-b'*x7+2;
fprintf('   nominal   robust unfeas.  robust feas.\n')
fprintf('   %6.4f    %6.4f          %10.8f   %10.8f   %10.8f\n',q0,q1,q2,q3,q4)

